<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_whatsapp_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Reglas multi-compañía -->
    <record id="rule_whatsapp_account_company" model="ir.rule">
        <field name="name">WhatsApp: Cuentas Multi-compañía</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_whatsapp_message_company" model="ir.rule">
        <field name="name">WhatsApp: Mensajes Multi-compañía</field>
        <field name="model_id" ref="model_whatsapp_message"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
