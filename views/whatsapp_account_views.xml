<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_account_view_form" model="ir.ui.view">
        <field name="name">whatsapp.account.form</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" string="Test Credentials" type="object"
                            class="btn-primary" icon="fa-check-circle"/>
                    <button name="action_sync_templates" string="Synchronize Templates" type="object"
                            class="btn-secondary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_templates" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="template_count" widget="statinfo" string="Templates"/>
                        </button>
                        <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-whatsapp">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Name"/>
                        <h1><field name="name" placeholder="Ej: Motor Group TE WhatsApp"/></h1>
                    </div>
                    <group string="SENDING MESSAGES">
                        <group>
                            <field name="app_id" placeholder="Ej: 1234567890"/>
                            <field name="phone_number_id" placeholder="Ej: 1234123455"/>
                            <field name="token" password="True" placeholder="EAAB..."/>
                        </group>
                        <group>
                            <field name="app_secret" password="True"/>
                            <field name="account_uid" string="WhatsApp Business Account ID" placeholder="Ej: 1234567890"/>
                            <field name="phone_uid" string="Phone Number" placeholder="+507 6123-4567"/>
                            <field name="api_version"/>
                        </group>
                    </group>
                    <group string="RECEIVING MESSAGES">
                        <group>
                            <field name="callback_url" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                        <group>
                            <field name="webhook_verify_token" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <group string="NOTIFICATIONS">
                        <group>
                            <field name="notify_user_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="allowed_company_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="whatsapp_account_view_list" model="ir.ui.view">
        <field name="name">whatsapp.account.list</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone_uid"/>
                <field name="phone_number_id"/>
                <field name="template_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_account_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Business Accounts</field>
        <field name="res_model">whatsapp.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configura tu primera cuenta de WhatsApp Business (Meta Cloud API).
            </p>
            <p>
                Ingresa el Phone Number ID, WABA ID y Access Token generados en Meta for Developers.
            </p>
        </field>
    </record>
</odoo>
