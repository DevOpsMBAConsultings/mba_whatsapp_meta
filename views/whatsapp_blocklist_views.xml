<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_blocklist_view_form" model="ir.ui.view">
        <field name="name">whatsapp.blocklist.form</field>
        <field name="model">whatsapp.blocklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="mobile_number" placeholder="Ej: 50761234567"/>
                        <field name="reason" placeholder="Solicitó no recibir más mensajes de cobro/promociones..."/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_blocklist_view_list" model="ir.ui.view">
        <field name="name">whatsapp.blocklist.list</field>
        <field name="model">whatsapp.blocklist</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="mobile_number"/>
                <field name="reason"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_blocklist_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Blocklist</field>
        <field name="res_model">whatsapp.blocklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Lista negra de números (Opt-out).
            </p>
            <p>
                Los números registrados aquí serán excluidos automáticamente de envíos de plantillas y recordatorios masivos.
            </p>
        </field>
    </record>
</odoo>
